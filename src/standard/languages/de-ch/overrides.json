  },
  "intake.Q6b.title.0": {
    "en": "How many of the children in your household go to school or day-care?",
    "de": "Wie viele Kinder in Ihrem Haushalt gehen zur Schule oder in die Tagesbetreuung (Kindergarten, Kindertagesstätte..)?"
  },
  "intake.Q6b.helpGroup.text.0": {
    "en": "Why are we asking this?",
    "de": "Warum fragen wir Sie das?"
  },
  "intake.Q6b.helpGroup.text.1": {
    "en": "Attending school, daycare, or childcare can increase the risk of contracting the coronavirus or influenza, as well as other similar illnesses. We wish to study this issue.",
    "de": "Der Besuch einer Schule oder einer Tagesbetreuung (Kindergarten, Kindertagesstätte..) kann das Risiko einer möglichen Ansteckung mit dem Coronavirus oder der Grippe (Influenza) sowie mit anderen ähnlichen Krankheiten erhöhen. Wir möchten dieses Thema untersuchen."
  },
  "intake.Q6b.helpGroup.text.2": {
    "en": "How should I answer this question?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "intake.Q6b.helpGroup.text.3": {
    "en": "If your child attends school, daycare or childcare (even if only one day a week), please count it. Participation in (sport) associations or other extracurricular activities does not count.",
    "de": "Wenn Ihr Kind eine Schule, eine Kindertagesstätte oder eine Kinderbetreuung besucht (auch wenn es nur einen Tag in der Woche ist), zählen Sie dies bitte mit. Die Teilnahme an (Sport-)Vereinen oder anderen außerschulischen Aktivitäten zählt nicht mit."
  },
  "intake.Q6b.rg.scg.option.0": {
    "en": "None",
    "de": "Keine"
  },
  "intake.Q6b.rg.scg.option.6": {
    "en": "More than 5",
    "de": "Mehr als 5"
  },
  "intake.Q7.title.0": {
    "en": "What means of transportation do you typically use for your daily activities?",
    "de": "Welches Transportmittel benutzen Sie im Alltag?"
  },
  "intake.Q7.helpGroup.text.0": {
    "en": "Why are we asking this?",
    "de": "Warum fragen wir Sie das?"
  },
  "intake.Q7.helpGroup.text.1": {
    "en": "We want to know if people who regularly use public transportation have a higher risk of infection.",
    "de": "Wir wollen herausfinden, ob Menschen, die regelmässig öffentliche Verkehrsmittel benutzen, ein höheres Infektionsrisiko haben."
  },
  "intake.Q7.helpGroup.text.2": {
    "en": "How should I answer this question?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "intake.Q7.helpGroup.text.3": {
    "en": "Mark the box that best matches the means of transportation you most frequently use.",
    "de": "Kreuzen Sie die Option an, die am Ihr am häufigsten genutztes Verkehrsmittel beschreibt."
  },
  "intake.Q7.rg.9JtQ.text.0": {
    "en": "Please select the transportation means you use the most.",
    "de": "Bitte wählen Sie das Verkehrsmittel aus, das Sie am häufigsten benutzen."
  },
  "intake.Q7.rg.scg.option.0": {
    "en": "Walking",
    "de": "Zu Fuss"
  },
  "intake.Q7.rg.scg.option.1": {
    "en": "Bike",
    "de": "Velo"
