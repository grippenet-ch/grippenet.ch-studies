  "weekly.HS.Q2.title.0": {
    "en": "In the previous questionnaire, you indicated that you still had symptoms. Are your current symptoms the same as before?",
    "de": "Im letzten Fragebogen gaben Sie an, noch Symptome zu haben. Handelt es sich bei Ihren aktuellen Symptomen um dieselben wie zuvor?"
  },
  "weekly.HS.Q2.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.HS.Q2.helpGroup.text.1": {
    "en": "To make completing the questionnaire faster for you.",
    "de": "Damit das Beantworten des Fragebogens für Sie schneller geht."
  },
  "weekly.HS.Q2.helpGroup.text.2": {
    "en": "How should I answer this question?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "weekly.HS.Q2.helpGroup.text.3": {
    "en": "If you believe that the symptoms you report today are due to the same infection or cause (within the same period the symptoms occurred), please answer ‘yes’.",
    "de": "Wenn Sie der Meinung sind, dass die Symptome, die Sie heute angeben, auf dieselbe Infektion oder Ursache zurückzuführen sind (im selben Zeitraum, in dem die Symptome aufgetreten sind), antworten Sie bitte mit ‚Ja‘."
  },
  "weekly.HS.Q2.rg.scg.option.0": {
    "en": "Yes",
    "de": "Ja"
  },
  "weekly.HS.Q2.rg.scg.option.1": {
    "en": "No",
    "de": "Nein"
  },
  "weekly.HS.Q2.rg.scg.option.2": {
    "en": "I don’t know",
    "de": "Ich weiss es nicht"
  },
  "weekly.HS.Q2.rg.scg.option.3": {
    "en": "This does not apply to me",
    "de": "Das trifft nicht auf mich zu"
  },
  "weekly.HS.Qcov3.title.0": {
    "en": "Did you have close contact with someone who had the same symptoms in the 14 days before your symptoms began?",
    "de": "Hatten Sie in den 14 Tagen vor Beginn Ihrer Symptome engen Kontakt zu einer Person mit denselben Symptomen?"
  },
  "weekly.HS.Qcov3.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.HS.Qcov3.helpGroup.text.1": {
    "en": "It helps us study how respiratory pathogens spread within the population.",
    "de": "Es hilft uns zu untersuchen wie sich respiratorische Eregger in der Bevölkerung ausbreitet."
  },
  "weekly.HS.Qcov3.rg.scg.option.0": {
    "en": "Yes",
    "de": "Ja"
  },
  "weekly.HS.Qcov3.rg.scg.option.1": {
    "en": "No",
    "de": "Nein"
  },
  "weekly.HS.Qcov3.rg.scg.option.2": {
    "en": "I don’t know",
    "de": "Ich weiss es nicht"
  },
  "weekly.HS.Qcov3b.title.0": {
    "en": "Is this person or one of these persons a member of your household?",
    "de": "Ist diese Person oder eine dieser Personen ein Mitglied Ihres Haushalts?"
  },
  "weekly.HS.Qcov3b.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.HS.Qcov3b.helpGroup.text.1": {
    "en": "The coronavirus and influenza can spread better indoors.",
    "de": "COVID-19 und die Grippe (Influenza) sind leichter in geschlossenen Räumen übertragbar."
  },
  "weekly.HS.Qcov3b.helpGroup.text.2": {
    "en": "How should I answer this question?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "weekly.HS.Qcov3b.helpGroup.text.3": {
    "en": "A member of the household is defined as a person (not necessarily a family member) who lives at the same address as you, and who shares the kitchen, living room, family room, or dining room.",
    "de": "Als Haushaltsmitglied gilt eine Person (nicht notwendigerweise ein Familienmitglied), die/der an derselben Adresse wie Sie wohnt und mit Ihnen die Küche, das Wohnzimmer, das Familienzimmer oder das Esszimmer teilt."
  },
  "weekly.HS.Qcov3b.rg.scg.option.0": {
    "en": "Yes",
    "de": "Ja"
  },
  "weekly.HS.Qcov3b.rg.scg.option.1": {
    "en": "No",
    "de": "Nein"
  },
  "weekly.HS.Qcov3b.rg.scg.option.2": {
    "en": "I don’t know",
    "de": "Ich weiss es nicht"
  },
  "weekly.HS.Q3.title.0": {
    "en": "On what day did you begin feeling the first symptoms? If you do not recall the exact date, please give an approximate date.",
    "de": "An welchem Tag verspürten Sie die ersten Symptome? Wenn Sie sich nicht an das genaue Datum erinnern können, geben Sie bitte ein ungefähres Datum an."
  },
  "weekly.HS.Q3.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.HS.Q3.helpGroup.text.1": {
    "en": "This question will help us to determine how many people are experiencing symptoms per day/week.",
    "de": "Anhand dieser Frage können wir feststellen, wie viele Personen pro Tag/Woche unter grippeähnlichen Symptomen leiden."
  },
  "weekly.HS.Q3.helpGroup.text.2": {
    "en": "How should I answer this question?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "weekly.HS.Q3.helpGroup.text.3": {
    "en": "Answer as precisely as possible.",
    "de": "Antworten Sie so präzise wie möglich."
  },
  "weekly.HS.Q3.rg.scg.dateInput.0": {
    "en": "Choose date",
    "de": "Datum auswählen."
  },
  "weekly.HS.Q3.rg.scg.option.1": {
    "en": "I don't know",
    "de": "Ich weiss es nicht"
  },
  "weekly.HS.Q4.title.0": {
    "en": "When did your symptoms end?",
    "de": "Seit wann haben Sie keine Symptome mehr?"
  },
  "weekly.HS.Q4.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.HS.Q4.helpGroup.text.1": {
    "en": "We can use the first and last dates of the complaints to calculate how long your complaints lasted. ",
    "de": "Anhand des Anfangs- und Enddatums des Auftretens Ihrer Symptome können wir berechnen, wie lange Ihre Beschwerden gedauert haben. "
  },
  "weekly.HS.Q4.helpGroup.text.2": {
    "en": "How should I answer this question?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "weekly.HS.Q4.helpGroup.text.3": {
    "en": "Answer as precisely as possible.",
    "de": "Antworten Sie so präzise wie möglich."
  },
  "weekly.HS.Q4.rg.scg.dateInput.0": {
    "en": "Choose date",
    "de": "Datum auswählen"
  },
  "weekly.HS.Q4.rg.scg.option.1": {
    "en": "I don't know",
    "de": "Ich weiss es nicht"
  },
  "weekly.HS.Q4.rg.scg.option.2": {
    "en": "I am still ill",
    "de": "Ich bin immer noch krank"
  },
  "weekly.HS.Q5.title.0": {
    "en": "Did your symptoms develop suddenly?",
    "de": "Sind Ihre Symptome plötzlich aufgetreten?"
  },
  "weekly.HS.Q5.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.HS.Q5.helpGroup.text.1": {
    "en": "The sudden onset of symptoms (within a few hours) is linked to the coronavirus and influenza.",
    "de": "Das plötzliche Auftreten von Symptomen (innerhalb weniger Stunden) deutet auf eine Infektion mit dem Coronavirus oder der Grippe (Influenza) hin."
  },
  "weekly.HS.Q5.helpGroup.text.2": {
    "en": "How should I answer this question?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "weekly.HS.Q5.helpGroup.text.3": {
    "en": "Answer “yes” if your symptoms appeared within a few hours, and not gradually over several days.",
    "de": "Wählen Sie 'ja', wenn Ihre Symptome innerhalb weniger Stunden aufgetreten sind und nicht erst nach und nach über mehrere Tage."
  },
  "weekly.HS.Q5.rg.scg.option.0": {
    "en": "Yes",
    "de": "Ja"
  },
  "weekly.HS.Q5.rg.scg.option.1": {
    "en": "No",
    "de": "Nein"
  },
  "weekly.HS.Q5.rg.scg.option.2": {
    "en": "I don’t know",
    "de": "Ich weiss es nicht"
  },
  "weekly.HS.Q6.title.0": {
    "en": "On what day did your fever start? If you do not recall the exact date, please give an approximate date.",
    "de": "An welchem Tag hat Ihr Fieber begonnen? Wenn Sie sich nicht an das genaue Datum erinnern können, geben Sie bitte ein ungefähres Datum ein."
  },
  "weekly.HS.Q6.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.HS.Q6.helpGroup.text.1": {
    "en": "Fever is an important diagnostic symptom, so we would like to know when the fever appeared.",
    "de": "Fieber ist ein wichtiges Symptom um eine richtige Diagnose zu stellen, daher möchten wir wissen, wann das Fieber zuerst aufgetreten ist."
  },
  "weekly.HS.Q6.helpGroup.text.2": {
    "en": "How should I answer this question?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "weekly.HS.Q6.helpGroup.text.3": {
    "en": "Answer as precisely as possible.",
    "de": "Antworten Sie so genau wie möglich."
  },
  "weekly.HS.Q6.rg.scg.dateInput.0": {
    "en": "Choose date",
    "de": "Datum auswählen"
  },
  "weekly.HS.Q6.rg.scg.option.1": {
    "en": "I don’t know",
    "de": "Ich weiss es nicht"
  },
