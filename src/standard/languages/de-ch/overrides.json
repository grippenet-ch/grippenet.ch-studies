  "intake.Q11.title.0": {
    "en": "Do you take regular medication for any of the following medical conditions?",
    "de": "Nehmen Sie regelmässig Medikamente gegen eine der folgenden Krankheiten ein?"
  },
  "intake.Q11.helpGroup.text.0": {
    "en": "Why are we asking this?",
    "de": "Warum fragen wir Sie das?"
  },
  "intake.Q11.helpGroup.text.1": {
    "en": "This question allows us to find out whether you have other medical conditions that may increase your risk of having more severe illness if you are infected.",
    "de": "Diese Frage erlaubt es uns herauszufinden, ob Sie andere Erkrankungen haben, die Ihr Risiko für einen schweren Verlauf im Falle einer Infektion mit Influenza oder COVID-19 erhöhen könnten."
  },
  "intake.Q11.helpGroup.text.2": {
    "en": "How should I answer it?",
    "de": "Wie soll ich diese Frage beantworten? "
  },
  "intake.Q11.helpGroup.text.3": {
    "en": "Only answer \"yes\" if you take regular medication for your medical problem. If, for instance, you only occasionally take an asthma inhaler, then do not answer \"yes\" for asthma.",
    "de": "Kreuzen Sie nur 'Ja' an, wenn Sie regelmäßig Medikamente für Ihr medizinisches Problem einnehmen. Wenn Sie z. B. nur gelegentlich einen Asthma-Inhalator benötigen, kreuzen Sie bitte nicht ja` an für Asthma."
  },
  "intake.Q11.rg.hYo0.text.0": {
    "en": "Select all options that apply",
    "de": "Wählen Sie alle zutreffenden Optionen aus"
  },
  "intake.Q11.rg.mcg.option.0": {
    "en": "No",
    "de": "Nein"
  },
  "intake.Q11.rg.mcg.option.1": {
    "en": "Asthma",
    "de": "Asthma"
  },
  "intake.Q11.rg.mcg.option.2": {
    "en": "Diabetes",
    "de": "Diabetes"
  },
  "intake.Q11.rg.mcg.option.3": {
    "en": "Chronic lung disorder besides asthma e.g., COPD, emphysema, or other disorders that affect your breathing",
    "de": "Chronische Lungenerkrankung neben Asthma zum Beispiel COPD, Emphysem oder andere Erkrankungen, die Ihre Atmung erschweren können"
  },
  "intake.Q11.rg.mcg.option.4": {
