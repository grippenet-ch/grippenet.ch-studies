    "en": "I would rather not answer",
    "de": "Diese Frage möchte ich lieber nicht beantworten"
  },
  "intake.Q12.title.0": {
    "en": "Are you currently pregnant?",
    "de": "Sind Sie zur Zeit schwanger?"
  },
  "intake.Q12.helpGroup.text.0": {
    "en": "Why are we asking this?",
    "de": "Warum fragen wir Sie das?"
  },
  "intake.Q12.helpGroup.text.1": {
    "en": "Pregnancy is a potential risk factor for severe symptoms in the event of infection.",
    "de": "Eine Schwangerschaft ist ein potenzieller Risikofaktor für einen schweren Verlauf im Falle einer Erkrankung mit Influenza oder COVID-19."
  },
  "intake.Q12.rg.scg.option.0": {
    "en": "Yes",
    "de": "Ja"
  },
  "intake.Q12.rg.scg.option.1": {
