  "weekly.EX.Q9.title.0": {
    "en": "Did you take medication for your symptoms?",
    "de": "Haben Sie Medikamente gegen Ihre Symptome genommen?"
  },
  "weekly.EX.Q9.helpGroup.text.0": {
    "en": "Why are we asking this?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.EX.Q9.helpGroup.text.1": {
    "en": "To find out who gets treated, and how effective treatment is.",
    "de": "Um zu untersuchen, wer behandelt wird und wie wirksam diese Behandlung ist."
  },
  "weekly.EX.Q9.helpGroup.text.2": {
    "en": "How should I answer it?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "weekly.EX.Q9.helpGroup.text.3": {
    "en": "Only record those medications that you used because of your symptoms. If you are on other medications because of a pre-existing condition, then do not record these.",
    "de": "Geben Sie nur die Medikamente an, die Sie aufgrund Ihrer Symptome einnehmen. Wenn Sie andere Medikamente aufgrund Vorerkranungen einnehmen, tragen Sie diese hier nicht ein."
  },
  "weekly.EX.Q9.rg.vMc3.text.0": {
    "en": "Select all options that apply",
    "de": "Wählen Sie alle zutreffenden Antworten aus"
  },
  "weekly.EX.Q9.rg.mcg.option.0": {
    "en": "No medication",
    "de": "Keine Medikamente"
  },
  "weekly.EX.Q9.rg.mcg.option.1": {
    "en": "Pain killers (e.g. paracetamol, lemsip, ibuprofen, aspirin, calpol, etc)",
    "de": "Schmerzmittel (z. B. Paracetamol, Lemsip, Ibuprofen, Aspirin, Calpol, usw.)"
  },
  "weekly.EX.Q9.rg.mcg.option.2": {
    "en": "Cough medication (e.g. expectorants)",
    "de": "Hustenmedikamente (z. B. schleimlösende Mittel)"
  },
  "weekly.EX.Q9.rg.mcg.option.3": {
    "en": "Antivirals against influenza (eg: Tamiflu)",
    "de": "Antivirale Medikament gegen die Grippe (Influenza) wie z.B. Tamiflu"
  },
  "weekly.EX.Q9.rg.mcg.option.4": {
    "en": "Antibiotics",
    "de": "Antibiotika"
  },
  "weekly.EX.Q9.rg.mcg.option.5": {
    "en": "Homeopathy",
    "de": "Homeopathische Mittel"
  },
  "weekly.EX.Q9.rg.mcg.option.6": {
    "en": "Alternative medicine (essential oil, phytotherapy, etc.)",
    "de": "Alternative Medizin (ätherisches Öl, Phytotherapie usw.)"
  },
  "weekly.EX.Q9.rg.mcg.option.7": {
    "en": "Other",
    "de": "Andere"
  },
  "weekly.EX.Q9.rg.mcg.option.8": {
    "en": "I don't know or can't remember.",
    "de": "Ich weiss es nicht oder kann mich nicht erinnern."
  },
  "weekly.EX.Q14.title.0": {
    "en": "Because of your symptoms, were you hospitalized?",
    "de": "Wurden Sie aufgrund Ihrer Symptome hospitalisiert?"
  },
  "weekly.EX.Q14.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.EX.Q14.helpGroup.text.1": {
    "en": "We want to understand the rates of hospitalization due to symptoms",
    "de": "Wir möchten die Häufigkeit von Krankenhausaufenthalten aufgrund den entsprechenden Symptomen verstehen"
  },
  "weekly.EX.Q14.rg.scg.option.0": {
    "en": "Yes",
    "de": "Ja"
  },
  "weekly.EX.Q14.rg.scg.option.1": {
    "en": "No",
    "de": "Nein"
  },
  "weekly.EX.Q10.title.0": {
    "en": "Did you change your daily routine because of your symptoms?",
    "de": "Haben Sie Ihren Tagesablauf aufgrund Ihrer Symptome geändert??"
  },
  "weekly.EX.Q10.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.EX.Q10.helpGroup.text.1": {
    "en": "To determine how the symptoms are impacting your daily life.",
    "de": "Um zu verstehen, wie Ihre Symptome Ihren Alltag beeinträchtigen."
  },
  "weekly.EX.Q10.helpGroup.text.2": {
    "en": "How should I answer this question?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "weekly.EX.Q10.helpGroup.text.3": {
    "en": "We want to find out if you have missed work or school due to your symptoms, or if you have modified your daily routine. We are interested in changes due to your symptoms. For example, if you were unable to engage in sport activities. If you are a student and were unable to attend online classes due to your symptoms, you should also select option 2.",
    "de": "Wir möchten wissen, ob Sie aufgrund Ihrer Symptome bei der Arbeit oder in der Schule gefehlt haben oder ob Sie Ihren Tagesablauf in irgendeiner Weise verändert haben (z. B. wenn Sie nicht in der Lage waren, Sport zu treiben). Wir sind an Veränderungen interessiert, die auf Ihre Symptome zurückzuführen sind. Wenn Sie studieren und aufgrund Ihrer Symptome nicht am Unterricht teilnehmen konnten, wählen Sie bitte auch Option 2."
  },
  "weekly.EX.Q10.rg.scg.option.0": {
    "en": "No, I was able to do my daily activities as usual.",
    "de": "Nein, ich konnte meinem Alltag wie gewohnt nachgehen."
  },
  "weekly.EX.Q10.rg.scg.option.1": {
    "en": "Yes, but I did not take time off from work or school.",
    "de": "Ja, aber ich habe mir keine Auszeit von der Arbeit oder der Schule genommen."
  },
  "weekly.EX.Q10.rg.scg.option.2": {
    "en": "Yes, I took time off from work or school.",
    "de": "Ja, ich habe eine Auszeit von der Arbeit oder der Schule genommen."
  },
  "weekly.EX.Q10b.title.0": {
    "en": "Are you currently still unable to work or attend school due to your symptoms?",
    "de": "Sind Sie aufgrund Ihrer Symptome derzeit noch nicht in der Lage, wieder zu arbeiten oder in die Schule zu gehen?"
  },
  "weekly.EX.Q10b.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir das?"
  },
  "weekly.EX.Q10b.helpGroup.text.1": {
    "en": "To determine how symptoms are impacting your daily life.",
    "de": "Um zu untersuchen, wie Ihre Symptome Ihren Alltag beeinflussen."
  },
  "weekly.EX.Q10b.helpGroup.text.2": {
    "en": "How should I answer this question?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "weekly.EX.Q10b.helpGroup.text.3": {
    "en": "Answer 'yes' if you missed work or school today due to certain symptoms.",
    "de": "Antworten Sie mit 'ja', wenn Sie heute wegen Ihrer Symptome bei der Arbeit oder in der Schule fehlen mussten."
  },
  "weekly.EX.Q10b.rg.scg.option.0": {
    "en": "Yes",
    "de": "Ja"
  },
  "weekly.EX.Q10b.rg.scg.option.1": {
    "en": "No",
    "de": "Nein"
  },
  "weekly.EX.Q10b.rg.scg.option.2": {
    "en": "Other (I did not have to work or attend school today anyway.)",
    "de": "Andere (Ich musste heute sowieso nicht arbeiten oder zur Schule gehen.)"
  },
  "weekly.EX.Q10c.title.0": {
    "en": "For how many days have you been unable to work or attend to school as you usually would have?",
    "de": "Für wie viele Tage waren Sie nicht in der Lage, wie gewöhnlich zu arbeiten oder zur Schule zu gehen?"
  },
  "weekly.EX.Q10c.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.EX.Q10c.helpGroup.text.1": {
    "en": "To estimate the number of days a person misses work or school due to certain symptoms.",
    "de": "Um zu evaluieren, wie viele Tage eine Person aufgrund bestimmter Symptome nicht arbeiten oder zur Schule gehen kann."
  },
  "weekly.EX.Q10c.helpGroup.text.2": {
    "en": "How should I answer this question?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "weekly.EX.Q10c.helpGroup.text.3": {
    "en": "Only count the days that you would otherwise have worked or attended school.",
    "de": "Zählen Sie nur die Tage, an denen Sie sonst gearbeitet hätten oder zur Schule gegangen wären."
  },
  "weekly.EX.Q10c.rg.ddg.option.0": {
    "en": "1 day",
    "de": "1 Tag"
