    "de": "Ja, das Resultat war nicht eindeutig."
  },
  "weekly.EX.Qcov16b.rg.scg.option.3": {
    "en": "No, I have not yet received the test results.",
    "de": "Nein, ich habe mein Testresultat noch nicht erhalten."
  },
  "weekly.EX.Qcov16b.rg.scg.option.4": {
