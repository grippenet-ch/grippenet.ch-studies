    "de": "Nein"
  },
  "intake.Q12.rg.scg.option.2": {
    "en": "Don't know/would rather not answer",
    "de": "Ich weiss es nicht/diese Frage möchte ich lieber nicht beantworten"
  },
  "intake.Q12b.title.0": {
    "en": "Which trimester of the pregnancy are you in?",
    "de": "In welchem Trimester der Schwangerschaft befinden Sie sich?"
  },
  "intake.Q12b.helpGroup.text.0": {
    "en": "Why are we asking this?",
    "de": "Warum fragen wir Sie das?"
  },
  "intake.Q12b.helpGroup.text.1": {
    "en": "The risk of severe symptoms can vary depending on the pregnancy trimester, but this link has not yet been clearly established.",
    "de": "Das Risiko eines schweren Verlaufs kann je nach Schwangerschaftstrimester variieren. Dieser Zusammenhang ist jedoch noch nicht eindeutig geklärt."
  },
  "intake.Q12b.rg.scg.option.0": {
    "en": "First trimester (week 1-12)",
    "de": "Erstes Trimester (Woche 1-12)"
  },
  "intake.Q12b.rg.scg.option.1": {
    "en": "Second trimester (week 13-28)",
    "de": "Zweites Trimester (Woche 13-28)"
  },
  "intake.Q12b.rg.scg.option.2": {
    "en": "Third trimester (week 29-delivery)",
    "de": "Drittes Trimester (29. Woche - Entbindung)"
  },
  "intake.Q12b.rg.scg.option.3": {
    "en": "Don't know/would rather not answer",
    "de": "Ich weiss es nicht/diese Frage möchte ich lieber nicht beantworten"
  },
  "intake.Q13.title.0": {
    "en": "Do you smoke tobacco?",
    "de": "Rauchen Sie Tabakwaren?"
  },
  "intake.Q13.helpGroup.text.0": {
    "en": "Why are we asking this?",
    "de": "Warum fragen wir Sie das?"
  },
  "intake.Q13.helpGroup.text.1": {
    "en": "Smoking might make you more likely to get a more severe dose of viral disease. We would like to test this.",
    "de": "Rauchen könnte die Wahrscheinlichkeit erhöhen, einer höheren Viruslast (viral load) ausgesetzt zu sein. Diesen Zusammenhang möchten wir gerne untersuchen."
  },
  "intake.Q13.helpGroup.text.2": {
    "en": "How should I answer it?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "intake.Q13.helpGroup.text.3": {
    "en": "Please, answer as accurately as possible.",
    "de": "Bitte antworten Sie so genau wie möglich."
  },
  "intake.Q13.rg.scg.option.0": {
    "en": "No",
    "de": "Nein"
  },
  "intake.Q13.rg.scg.option.1": {
    "en": "Yes, occasionally",
    "de": "Ja, manchmal"
  },
  "intake.Q13.rg.scg.option.2": {
    "en": "Yes, daily, fewer than 10 times a day",
    "de": "Ja, täglich - weniger als 10 Zigaretten pro Tag"
  },
  "intake.Q13.rg.scg.option.3": {
    "en": "Yes, daily, 10 or more times a day",
    "de": "Ja, täglich - mehr als 10 Zigaretten pro Tag"
  },
  "intake.Q13.rg.scg.option.4": {
    "en": "Yes, only e-cigarettes",
    "de": "Ja, aber nur E-Zigaretten"
  },
  "intake.Q13.rg.scg.option.5": {
    "en": "Dont know/would rather not answer",
    "de": "Ich weiss es nicht/diese Frage möchte ich lieber nicht beantworten"
  },
