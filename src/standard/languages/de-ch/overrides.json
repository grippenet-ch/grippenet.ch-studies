  "weekly.EX.Qcov18.title.0": {
    "en": "What is the main reason you haven’t sought any health services for your symptoms?",
    "de": "Was ist der Hauptgrund, warum Sie wegen Ihrer Symptome keine medizinische Dienste aufgesucht haben?"
  },
  "weekly.EX.Qcov18.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.EX.Qcov18.helpGroup.text.1": {
    "en": "To understand why some do not seek healt care.",
    "de": "Um zu verstehen, weshalb manche keine medizinische Dienste aufsuchen."
  },
  "weekly.EX.Qcov18.helpGroup.text.2": {
    "en": "How should I answer this question?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "weekly.EX.Qcov18.helpGroup.text.3": {
    "en": "Multiple answers are possible.",
    "de": "Mehrere Antworten sind möglich."
  },
  "weekly.EX.Qcov18.rg.4opV.text.0": {
    "en": "Multiple answers possible.",
    "de": "Mehrere Antworten sind möglich."
  },
  "weekly.EX.Qcov18.rg.scg.option.0": {
    "en": "My symptoms have just appeared.",
    "de": "Meine Symptome sind gerade erst aufgetreten."
  },
  "weekly.EX.Qcov18.rg.scg.option.1": {
    "en": "My symptoms are mild.",
    "de": "Meine Symptome sind mild."
  },
  "weekly.EX.Qcov18.rg.scg.option.2": {
    "en": "I have these symptoms often.",
    "de": "Ich habe diese Symptome oft."
  },
  "weekly.EX.Qcov18.rg.scg.option.3": {
    "en": "I think I know what I have and I take care of it myself.",
    "de": "Ich glaube, ich weiss, was ich habe, und ich behandle mich selber."
  },
  "weekly.EX.Qcov18.rg.scg.option.4": {
    "en": "I think there is no effective treatment for my symptoms.",
    "de": "Ich glaube, es gibt keine wirksame Behandlung für meine Symptome."
  },
  "weekly.EX.Qcov18.rg.scg.option.5": {
    "en": "It is too hard to get an appointment quickly",
    "de": "Es ist zu schwierig, schnell einen Termin zu bekommen"
  },
  "weekly.EX.Qcov18.rg.scg.option.6": {
    "en": "I do not have time",
    "de": "Ich habe keine Zeit."
  },
  "weekly.EX.Qcov18.rg.scg.option.7": {
    "en": "For financial reasons",
    "de": "Aus finanziellen Gründen."
  },
  "weekly.EX.Qcov18.rg.scg.option.8": {
    "en": "Out of concern that a diagnosis might disrupt my daily life, work or leisure time.",
    "de": "Aus Sorge, dass eine Krankheit(sdiagnose) meinen Alltag, Job oder meine Freizeit einschränkt."
  },
  "weekly.EX.Qcov18.rg.scg.option.9": {
    "en": "Because I am vaccinated against respiratory infections (like COVID-19 and flu).",
    "de": "Weil ich gegen Atemwegsinfektionen (wie COVID-19 und die Grippe) geimpft bin."
  },
  "weekly.EX.Qcov18.rg.scg.input.10": {
    "en": "For another reason",
    "de": "Aus anderen Gründen"
  },
  "weekly.EX.Qcov18.rg.scg.description.input.10": {
    "en": "Describe here (optional)",
    "de": "Beschreiben Sie diese hier (freiwillig)"
  },
  "weekly.EX.Qcov18.rg.scg.option.11": {
    "en": "I don't know or don't want to answer",
    "de": "Ich weiss es nicht oder möchte diese Frage nicht beantworten."
  },
  "weekly.EX.Qcov16h.title.0": {
    "en": "Have you taken a test due to your symptoms to find out what you have?",
    "de": "Haben Sie wegen Ihrer Symptome einen Test gemacht, um herauszufinden, was Sie haben?"
  },
  "weekly.EX.Qcov16h.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.EX.Qcov16h.helpGroup.text.1": {
    "en": "We would like to know which symptoms lead people to get tested.",
    "de": "Wir möchten untersuchen, welche Symptome dazu führen, dass sich Personen testen."
  },
  "weekly.EX.Qcov16h.rg.scg.option.0": {
    "en": "Yes",
    "de": "Ja"
  },
  "weekly.EX.Qcov16h.rg.scg.option.1": {
    "en": "No, not yet, but I plan to do a test soon.",
    "de": "Nein, noch nicht, aber ich möchte mich bald testen lassen."
  },
  "weekly.EX.Qcov16h.rg.scg.option.2": {
    "en": "No, I have a prescription but will not undergo a test",
    "de": "Nein, es wurde mir zwar verschrieben jedoch werde ich mich nicht testen lassen."
  },
  "weekly.EX.Qcov16h.rg.scg.option.3": {
    "en": "No",
    "de": "Nein"
  },
  "weekly.EX.Qcov16i.title.0": {
    "en": "Which test(s) was it?",
    "de": "Welche(n) Test(s) haben Sie gemacht?"
  },
  "weekly.EX.Qcov16i.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.EX.Qcov16i.helpGroup.text.1": {
    "en": "To investigate whether people with (flu-like) symptoms are getting tested.",
    "de": "Um zu untersuchen, ob sich Personen mit (grippeähnlichen) Symptomen testen lassen."
  },
  "weekly.EX.Qcov16i.rg.tyZC.text.0": {
    "en": "Multiple answers possible",
    "de": "Mehrere Antworten sind möglich."
  },
  "weekly.EX.Qcov16i.rg.mcg.option.0": {
    "en": "A PCR test (a swab in nose or mouth, or a sputum or saliva sample)",
    "de": "Ein PCR-Test (Nasen- oder Rachenabstrich oder eine Sputum- oder Speichelprobe)"
  },
  "weekly.EX.Qcov16i.rg.mcg.option.1": {
    "en": "A serological analysis (screening for antibodies from a blood sample)",
    "de": "Eine serologische Analyse (Screening auf Antikörper anhand einer Blutprobe)"
  },
  "weekly.EX.Qcov16i.rg.mcg.option.2": {
    "en": "A rapid antigen test (nasopharyngeal sampling, done by a health professional and results are obtained in less than one hour)",
    "de": "Ein Antigen-Schnelltest (Nasenabstrich, der vom Gesunheitspersonal durchgeführt wird und das Ergebnis liegt in weniger als einer Stunde vor)"
  },
  "weekly.EX.Qcov16i.rg.mcg.option.3": {
    "en": "A rapid antigen self-test (nasopharyngeal sampling that can be done by oneself and results are obtained in a few minutes)",
    "de": "Ein Antigen-Schnell-Selbsttest (Nasenabstrich wird selbst durchgeführt und das Ergebnis in wenigen Minuten vorliegt)"
  },
  "weekly.EX.Qcov16b.title.0": {
    "en": "Do you know the result of your PCR test? (if several were performed and at least one was positive, choose the 'Positive' answer)",
    "de": "Kennen Sie das Ergebnis Ihres PCR-Tests? (Wenn mehrere Tests durchgeführt wurden und mindestens einer positiv war, wählen Sie die Antwort 'Positiv')"
  },
  "weekly.EX.Qcov16b.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.EX.Qcov16b.helpGroup.text.1": {
    "en": "We want to understand which virus is spreading within the population.",
    "de": "Wir möchten verstehen, welcher Virus sich in der Bevölkerun verbreitet."
  },
  "weekly.EX.Qcov16b.rg.scg.option.0": {
    "en": "Yes, positive for COVID-19",
    "de": "Ja, positiv für COVID-19"
  },
  "weekly.EX.Qcov16b.rg.scg.option.1": {
    "en": "Yes, negative for COVID-19",
    "de": "Ja, negativ für COVID-19"
  },
  "weekly.EX.Qcov16b.rg.scg.option.2": {
