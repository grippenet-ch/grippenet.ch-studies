  "intake.Q4d.title.0": {
    "en": "What is your highest level of education/qualification?",
    "de": "Was ist Ihr höchster Bildungsabschluss?"
  },
  "intake.Q4d.helpGroup.text.0": {
    "en": "Why are we asking this?",
    "de": "Warum fragen wir Sie das?"
  },
  "intake.Q4d.helpGroup.text.1": {
    "en": "To check how representative our sample is compared to the population in Switzerland or other countries as a whole.",
    "de": "Um zu überprüfen, wie repräsentativ unsere Stichprobe im Vergleich zur Gesamtbevölkerung anderer Länder ist (wie die UK, Italien, Belgien...) ist."
  },
  "intake.Q4d.helpGroup.text.2": {
    "en": "How should I answer it?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "intake.Q4d.helpGroup.text.3": {
    "en": "Please choose the box that represents your HIGHEST level of educational achievements. The different options roughly equate to: 1 - no qualifications, 2 - school-leaving exams at around 16 years of age, 3 - school-leaving exams at around 18 years of age, 4 - University degree or equivalent professional qualification, 5 - Higher degree or advanced professional qualification. If you are an adult who is currently undergoing part - time training(e.g.night school) then tick the box that represents your current highest level of education.",
    "de": "Bitte kreuzen Sie das Kästchen an, das Ihrem HÖCHSTEN Bildungsabschluss entspricht. Die verschiedenen Optionen entsprechen in etwa: 1 - kein Abschluss, 2 - Schulabschluss im Alter von ca. 16 Jahren, 3 - Schulabschluss im Alter von ca. 18 Jahren, 4 - Hochschul-/Universitätsabschluss oder gleichwertiger beruflicher Abschluss (Bachelorabschluss etc.), 5 - Weiterführender Hochschulabschluss oder höherer beruflicher Abschluss (Masterabschluss, PhD etc.). Wenn Sie eine erwachsene Person sind, die derzeit eine Teilzeitausbildung absolviert (z. B. Abendschule), kreuzen Sie bitte das Kästchen an, das Ihrem derzeitigen höchsten Bildungsabschluss entspricht."
  },
  "intake.Q4d.rg.nUk7.text.0": {
    "en": "Select all options that apply",
    "de": "Wählen Sie alle zutreffenden Optionen aus"
  },
  "intake.Q4d.rg.mcg.option.0": {
    "en": "I have no formal qualification",
    "de": "Ich habe kein offiziellen Abschluss"
  },
  "intake.Q4d.rg.mcg.option.1": {
    "en": "GCSEs, levels, CSEs or equivalent",
    "de": "Ablschuss der obligatorischen Schulzeit"
  },
  "intake.Q4d.rg.mcg.option.2": {
    "en": "A-levels or equivalent (e.g. Higher, NVQ Level3, BTEC)",
    "de": "Maturitätsabschluss (Gymnasium, Fachmaturitätsschule oder äquivalent) oder Lehrabschluss"
  },
  "intake.Q4d.rg.mcg.option.3": {
    "en": "Bachelor Degree (BA, BSc) or equivalent",
    "de": "Bachelorabschluss (Hochschule oder Universität) oder äquivalent"
  },
  "intake.Q4d.rg.mcg.option.4": {
    "en": "Higher Degree or equivalent (e.g. Master's Degree, PGCE, PhD, Medical Doctorate, Advanced Professional Award)",
    "de": "Hochschulabschluss oder äquivalent (z. B. Masterdiplom, Doktorat (PhD), weiterführende Hochschuldiplome)"
  },
  "intake.Q4d.rg.mcg.option.5": {
    "en": "I am still in education",
    "de": "Ich befinde mich noch in Ausbildung"
  },
  "intake.Q5.title.0": {
    "en": "Except people you meet on public transportation, do you have contact with any of the following during the course of a typical day?",
    "de": "Abgesehen von den Personen, die Sie in öffentlichen Verkehrsmitteln treffen, haben Sie im Laufe Ihres Alltages Kontakt mit folgenden Personen?"
  },
  "intake.Q5.helpGroup.text.0": {
    "en": "Why are we asking this?",
    "de": "Warum fragen wir Sie das?"
  },
  "intake.Q5.helpGroup.text.1": {
    "en": "To find out whether you are likely to be exposed to more infection risk than the average person (e.g., work with children, or patients).",
    "de": "Um herauszufinden, ob Sie einem höheren Infektionsrisiko ausgesetzt sind als der Durchschnitt der Bevölkerung (z. B. durch die Arbeit mit Kindern oder Patient:innen)."
  },
  "intake.Q5.helpGroup.text.2": {
    "en": "Hint:",
    "de": "Hinweis"
  },
  "intake.Q5.helpGroup.text.3": {
    "en": "Groups of people could include any setting where you come into contact with large numbers of people at once, e.g., a teacher who may contact many children in a day.",
    "de": "Zu diesen Personengruppen zählt jedes Umfeld, in dem Sie mit einer grösseren Anzahl von Personen gleichzeitig in Kontakt kommen können, z. B. ein/e Lehrer:in, der/die an einem Tag mit vielen Kindern in Kontakt kommen kann."
  },
  "intake.Q5.rg.dwL8.text.0": {
    "en": "Select all options that apply",
    "de": "Wählen Sie alle zutreffenden Optionen aus"
  },
  "intake.Q5.rg.mcg.option.0": {
    "en": "More than 10 children or teenagers (without counting your own children)",
    "de": "Mehr als 10 Kinder oder Jugendliche (Ihre eigenen Kinder ausgenommen)"
  },
  "intake.Q5.rg.mcg.option.1": {
    "en": "More than 10 people aged over 65",
    "de": "Mehr als 10 Personen von über 65 Jahren"
  },
  "intake.Q5.rg.mcg.option.2": {
    "en": "Patients",
    "de": "Patient:innen"
  },
  "intake.Q5.rg.mcg.option.3": {
    "en": "Groups of people (more than 10 individuals at any one time)",
    "de": "Personengruppen (mehr als 10 Personen auf einmal)"
  },
  "intake.Q5.rg.mcg.option.4": {
    "en": "None of the above",
    "de": "Keiner der oben genannten Punkte ist zutreffend"
  },
  "intake.Q6.title.0": {
    "en": "INCLUDING YOU, how many people in each of the following age groups live in your household?",
    "de": "EINSCHLIESSLICH IHNEN, wie viele Personen der jeweiligen Altersgruppen leben in Ihrem Haushalt?"
  },
  "intake.Q6.helpGroup.text.0": {
    "en": "Why are we asking this?",
    "de": "Warum fragen wir Sie das?"
  },
  "intake.Q6.helpGroup.text.1": {
    "en": "Members of larger households, or those with children, may be more likely to get infected than others.",
    "de": "Angehörige grösserer Haushalte oder von Haushalten mit Kindern sind einem höheren Ansteckungsrisiko ausgesetzt als andere Personen."
  },
  "intake.Q6.rg.mat.row0.l.label.0": {
    "en": "0 - 4 years",
    "de": "0 - 4 Jahre alt"
  },
  "intake.Q6.rg.mat.row1.l.label.0": {
