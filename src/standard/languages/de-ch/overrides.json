  },
  "weekly.HS.Q6c.title.0": {
    "en": "Did you take your temperature?",
    "de": "Haben Sie Ihre Temperatur (Fieber) gemessen?"
  },
  "weekly.HS.Q6c.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.HS.Q6c.helpGroup.text.1": {
    "en": "If you have taken your temperature, we would like to know the highest body temperature you have measured.",
    "de": "Wenn Sie Ihre Temperatur gemessen haben, würden wir gerne die höchste gemessene Körpertemperatur erfahren."
  },
  "weekly.HS.Q6c.helpGroup.text.2": {
    "en": "How should I answer it?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "weekly.HS.Q6c.helpGroup.text.3": {
    "en": "Answer yes, if you took your temperature using a thermometer.",
    "de": "Antworten Sie mit 'ja', wenn Sie Ihre Temperatur mit einem Fiebermesser gemessen haben."
  },
  "weekly.HS.Q6c.rg.scg.option.0": {
    "en": "Yes",
    "de": "Ja"
  },
  "weekly.HS.Q6c.rg.scg.option.1": {
    "en": "No",
    "de": "Nein"
  },
  "weekly.HS.Q6c.rg.scg.option.2": {
    "en": "I don’t know",
    "de": "Ich weiss es nicht"
  },
  "weekly.HS.Q6d.title.0": {
    "en": "What was your highest temperature measured?",
    "de": "Was war Ihre höchste Temperatur, die Sie gemessen haben?"
  },
  "weekly.HS.Q6d.helpGroup.text.0": {
    "en": "Why are we asking this question?",
    "de": "Warum fragen wir Sie das?"
  },
  "weekly.HS.Q6d.helpGroup.text.1": {
    "en": "Certain infectious diseases cause a raised temperature.",
    "de": "Manche Infektionskrankheiten verursachen eine erhöhte Körpertemperatur (Fieber)."
  },
  "weekly.HS.Q6d.helpGroup.text.2": {
    "en": "How should I answer this question?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "weekly.HS.Q6d.helpGroup.text.3": {
    "en": "Please indicate the highest temperature you measured during the period in which you experienced your symptoms.",
    "de": "Bitte geben Sie die höchste Temperatur an, die Sie während des Zeitraums, in dem Sie Ihre Symptome hatten, gemessen haben."
  },
