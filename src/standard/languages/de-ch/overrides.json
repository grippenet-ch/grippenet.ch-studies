    "de": "45 - 64 Jahre alte"
  },
  "intake.Q6.rg.mat.row4.l.label.0": {
    "en": "65+",
    "de": "Älter als 65 Jahre alte"
  },
  "intake.Q6c.title.0": {
    "en": "Does one or several of these people have a higher risk of complications if infected with the flu or COVID (e.g, pregnant, over 65, underlying health condition, obese, etc.)?",
    "de": "Besteht bei einer oder mehreren dieser Personen ein erhöhtes Risiko für mögliche Komplikationen im Falle einer Grippen- oder COVID-19-Erkrankung (z. B. Schwangerschaft, über 65 Jahre alt, Grunderkrankung, Übergewichtigkeit usw.)?"
  },
  "intake.Q6c.helpGroup.text.0": {
    "en": "Why are we asking this?",
    "de": "Warum fragen wir Sie das?"
  },
  "intake.Q6c.helpGroup.text.1": {
    "en": "",
    "de": ""
  },
  "intake.Q6c.helpGroup.text.2": {
    "en": "How should I answer this question?",
    "de": "Wie soll ich diese Frage beantworten?"
  },
  "intake.Q6c.helpGroup.text.3": {
    "en": "",
    "de": ""
  },
  "intake.Q6c.rg.scg.option.0": {
    "en": "Yes",
    "de": "Ja"
  },
  "intake.Q6c.rg.scg.option.1": {
